#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {

    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &extra_keys_transform;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESC>;
            key-positions = <19 20>;
            timeout-ms = <200>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };

        comilla {
            bindings = <&kp SQT>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp Q        &kp W             &kp E           &kp R           &kp T      &kp Y            &kp U           &kp I           &kp O              &kp P           &none
&none  &mt LCTRL A  &mt LEFT_SHIFT S  &mt LEFT_ALT D  &mt LEFT_WIN F  &kp G      &kp H            &mt LEFT_WIN J  &mt LEFT_ALT K  &mt RIGHT_SHIFT L  &mt LCTRL SEMI  &none
&none  &kp Z        &kp X             &kp C           &kp V           &kp B      &kp N            &kp M           &kp COMMA       &kp DOT            &kp FSLH        &none
                                      &none           &kp SPACE       &lt 1 TAB  &lt 2 BACKSPACE  &kp ENTER       &none
            >;
        };

        adjust_layer {
            bindings = <
&none  &kp K_MUTE  &trans          &kp C_VOL_UP          &kp C_VOL_DN          &trans     &kp PLUS           &kp N7   &kp N8  &kp N9  &kp FSLH  &none
&none  &kp LCTRL   &kp LEFT_SHIFT  &kp LEFT_ALT          &trans                &kp EQUAL  &kp MINUS          &kp N4   &kp N5  &kp N6  &kp STAR  &none
&none  &trans      &trans          &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans     &trans             &kp N1   &kp N2  &kp N3  &trans    &none
                                   &none                 &trans                &trans     &lt 3 KP_NUMBER_0  &kp DOT  &none
            >;
        };

        lower_layer {
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN      &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp MINUS  &kp PLUS    &none
&none  &kp LCTRL        &kp LSHFT        &kp LALT  &kp RALT    &kp BSLH     &kp PG_UP  &kp HOME       &kp UP        &kp END    &kp INSERT  &none
&none  &kp GRAVE        &kp PRINTSCREEN  &kp SLCK  &kp CAPS    &trans       &kp PG_DN  &kp LEFT       &kp DOWN      &kp RIGHT  &kp DEL     &none
                                         &none     &trans      &mo 3        &trans     &trans         &none
            >;
        };

        raise_layer {
            bindings = <
&none  &kp F1        &kp F2        &kp F3        &kp F4  &kp F5      &kp F6          &kp F7                 &kp F8    &kp F9           &kp F10  &none
&none  &kp LCTRL     &kp LSHFT     &kp LALT      &trans  &trans      &kp LALT        &kp LEFT_PARENTHESIS   &kp LBKT  &kp LEFT_BRACE   &kp F11  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR  &kp LEFT_SHIFT  &kp RIGHT_PARENTHESIS  &kp RBKT  &kp RIGHT_BRACE  &kp F12  &none
                                   &none         &trans  &trans      &trans          &trans                 &none
            >;
        };
    };
};
